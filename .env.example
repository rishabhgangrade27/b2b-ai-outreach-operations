# Copy to .env and fill in for real runs. The demo (demo.py) does not require
# any of these - it runs entirely against mock integrations.

# --- LLM provider (drafting outreach content) ---
ANTHROPIC_API_KEY=

# --- CRM (contact/lead system of record) ---
CRM_API_KEY=
CRM_BOARD_ID=

# --- Email delivery ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=outreach@example.com
EMAIL_BCC_ADDRESS=

# --- Slack (human approval + operator commands) ---
SLACK_BOT_TOKEN=
SLACK_APPROVAL_CHANNEL_ID=

# --- Lead discovery (places/business search provider) ---
PLACES_API_KEY=

# --- Safety switch ---
# When true, no external side effect (send, CRM write, Slack post) actually
# fires - everything is logged instead. Always start a new environment here.
DRY_RUN=true
